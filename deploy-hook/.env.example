# deploy-hook 服务配置（复制为 .env 并按服务器实际修改）

# webhook 监听端口（建议 nginx 反代到此端口，不直接公网暴露）
HOOK_PORT=3100

# 部署鉴权 token（必填！改成随机长字符串，本地触发时用同一值）
# 生成方式：openssl rand -hex 32
DEPLOY_TOKEN=请用-openssl-rand-hex-32-生成-替换此行

# 部署脚本路径（默认同目录 deploy.sh）
DEPLOY_SCRIPT=

# 上传包大小上限（MB）
MAX_PKG_MB=300

# ===== 以下 deploy.sh 读取（pm2 通过 env 注入） =====

# 主业务部署根目录（含 dist/ server/）
APP_DIR=/opt/wood-store

# pm2 进程名
APP_NAME=wood-store-server

# 保留最近几个备份
KEEP_BACKUPS=5
